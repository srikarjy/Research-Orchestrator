# Research Orchestrator Environment Variables
# Copy to .env and fill in values for production

# ==========================================
# Aletheia (Reasoning Plane)
# ==========================================
WORKFLOW_ENGINE_URL=http://workflow-engine:8080
BIOLAB_MCP_URL=http://biolab-mcp:8081

# ==========================================
# Workflow Engine (Durable Execution Plane)
# ==========================================
PORT=8080
DATABASE_URL=sqlite:///data/workflow.db
LOG_LEVEL=info

# ==========================================
# Biolab MCP Server (Evidence + Action Plane)
# ==========================================
PORT=8081
SANDBOX_PATH=/tmp/research-sandbox
LOG_LEVEL=info

# Email (for Notifier agent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@research-orchestrator.local
SMTP_USE_TLS=true

# ==========================================
# Frontend
# ==========================================
VITE_WORKFLOW_ENGINE_BASE=http://localhost:8080
VITE_BIOLAB_MCP_BASE=http://localhost:8081

# ==========================================
# Optional: Real API Keys (for production)
# ==========================================
# PUBMED_API_KEY=
# UNIPROT_API_KEY=
# CHEMBL_API_KEY=
# PDB_API_KEY=